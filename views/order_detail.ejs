<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="container">
    <%- include('partials/flash') %>
    
    <div class="glass-panel" style="max-width: 800px; margin: 0 auto;">
        <a href="/orders" style="display:inline-block; margin-bottom: 1rem;">&larr; Back to Orders</a>
        
        <div class="order-header" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <h2>Order #<%= order.order_id %></h2>
            <p>Placed on: <%= new Date(order.created_at).toLocaleString() %></p>
            <p>Status: <span class="order-status status-<%= order.status %>"><%= order.status.toUpperCase() %></span></p>
        </div>
        
        <h3>Items</h3>
        <table class="cart-table" style="margin-bottom: 2rem;">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach(item => { %>
                    <tr>
                        <td><%= item.name %></td>
                        <td>$<%= parseFloat(item.price_at_purchase).toFixed(2) %></td>
                        <td><%= item.quantity %></td>
                        <td>$<%= (item.quantity * item.price_at_purchase).toFixed(2) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        
        <h3 style="text-align: right; color: var(--primary-color);">Total: $<%= parseFloat(order.total_amount).toFixed(2) %></h3>
    </div>
</div>

<%- include('partials/footer') %>
