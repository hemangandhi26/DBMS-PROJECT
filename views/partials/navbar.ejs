<nav class="navbar">
    <div class="nav-brand"><a href="/">NexusStore</a></div>
    <ul class="nav-links">
        <li><a href="/">Catalog</a></li>
        <% if (user) { %>
            <% if (user.role === 'host') { %>
                <li><a href="/admin">Dashboard</a></li>
            <% } else { %>
                <li><a href="/cart">Cart <% if (cartCount > 0) { %>(<%= cartCount %>)<% } %></a></li>
                <li><a href="/orders">Orders</a></li>
            <% } %>
            <li><a href="/auth/logout" class="btn-logout">Logout (<%= user.name %>)</a></li>
        <% } else { %>
            <li><a href="/auth/login">Login</a></li>
            <li><a href="/auth/register" class="btn-primary">Register</a></li>
        <% } %>
    </ul>
</nav>
