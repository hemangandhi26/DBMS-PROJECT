<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container dashboard-container">
    <div class="sidebar glass-panel">
        <h3>Admin Menu</h3>
        <ul style="list-style:none; margin-top:1rem; display:flex; flex-direction:column; gap:0.5rem;">
            <li><a href="/admin">Products</a></li>
            <li><a href="/admin/product/new" class="btn-secondary btn-sm" style="display:inline-block; margin-top:0.5rem;">+ Add New Product</a></li>
            <hr style="border-color: rgba(255,255,255,0.1); margin: 1rem 0;">
            <li><a href="/admin/orders">Manage Orders</a></li>
        </ul>
    </div>
    
    <div class="main-content">
        <%- include('../partials/flash') %>
        <h2>Manage Products</h2>
        <div class="cart-table-wrapper glass-panel">
            <table class="cart-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <tr>
                                <td><%= product.product_id %></td>
                                <td><%= product.name %></td>
                                <td>$<%= parseFloat(product.price).toFixed(2) %></td>
                                <td class="<%= product.stock_quantity > 0 ? 'in-stock' : 'out-of-stock' %>"><%= product.stock_quantity %></td>
                                <td>
                                    <a href="/admin/product/<%= product.product_id %>/edit" class="btn-secondary btn-sm">Edit</a>
                                    <form action="/admin/product/<%= product.product_id %>/delete" method="POST" style="display:inline-block;">
                                        <button type="submit" class="btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this product?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center">No products found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
