<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="container">
    <%- include('partials/flash') %>
    <div class="cart-container">
        <h2>Your Shopping Cart</h2>
        
        <% if (items && items.length > 0) { %>
            <div class="cart-table-wrapper glass-panel">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(item => { %>
                            <tr>
                                <td><%= item.name %></td>
                                <td>$<%= parseFloat(item.price).toFixed(2) %></td>
                                <td>
                                    <form action="/cart/update" method="POST" style="display:inline-block">
                                        <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
                                        <input type="number" name="quantity" value="<%= item.quantity %>" min="1" style="width: 60px; display:inline-block;">
                                        <button type="submit" class="btn-secondary btn-sm">Update</button>
                                    </form>
                                </td>
                                <td>$<%= (item.quantity * item.price).toFixed(2) %></td>
                                <td>
                                    <form action="/cart/remove" method="POST">
                                        <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
                                        <button type="submit" class="btn-danger btn-sm">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            
            <div class="cart-summary glass-panel">
                <h3>Cart Total: $<%= parseFloat(total).toFixed(2) %></h3>
                <form action="/orders/place" method="POST">
                    <button type="submit" class="btn-primary btn-lg">Proceed to Checkout</button>
                </form>
            </div>
        <% } else { %>
            <div class="empty-cart glass-panel">
                <p>Your cart is empty.</p>
                <a href="/" class="btn-secondary">Start Shopping</a>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
